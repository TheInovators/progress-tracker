PORT=5001
# Comma-separated. In production this is your Vercel domain.
CLIENT_ORIGIN=http://localhost:5173
# Set to 'on' to also accept Vercel preview deployment hostnames.
VERCEL_PREVIEWS=
JWT_SECRET=change-me-in-production
# Leave MONGO_URI unset to boot an in-memory MongoDB for local development.
MONGO_URI=
# Judge0. The free public instance is rate limited and often down; a self-hosted
# instance or a RapidAPI key is recommended.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_RAPIDAPI_KEY=
STATS_TTL_MINUTES=60
